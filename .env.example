# Environment variables for SiteForge AI

# Database (JSON file-based, no external DB needed)
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_SECRET="change-this-to-a-random-secret-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Your root domain for subdomains (e.g., siteforge.dev)
NEXT_PUBLIC_ROOT_DOMAIN="siteforge.dev"
