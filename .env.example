# Environment variables for SiteForge AI

# Upstash Redis (from Vercel Marketplace or upstash.com)
UPSTASH_REDIS_REST_URL="your-redis-url"
UPSTASH_REDIS_REST_TOKEN="your-redis-token"

# NextAuth
NEXTAUTH_SECRET="change-this-to-a-random-secret-in-production"
NEXTAUTH_URL="https://fantome-ai.vercel.app"

# Your root domain for subdomains
NEXT_PUBLIC_ROOT_DOMAIN="vercel.app"
